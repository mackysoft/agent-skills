<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MackySoft.AgentDistribution.Cli</AssemblyName>
    <RootNamespace>MackySoft.AgentDistribution.Cli</RootNamespace>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agent-distribution</ToolCommandName>
    <PackageId>MackySoft.AgentDistribution.Cli</PackageId>
    <Description>.NET CLI tool for building and operating skill and custom-agent packages.</Description>
    <PackageTags>agent;skills;cli;tool;generator;installer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <ProjectReference Include="../MackySoft.AgentDistribution/MackySoft.AgentDistribution.csproj" />
    <ProjectReference Include="../MackySoft.AgentDistribution.ConsoleAppFramework/MackySoft.AgentDistribution.ConsoleAppFramework.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="../MackySoft.AgentDistribution.Hosting/MackySoft.AgentDistribution.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../agent-distribution/generated/**/*"
          Link="agent-distribution/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="../MackySoft.AgentDistribution.ConsoleAppFramework/buildTransitive/MackySoft.AgentDistribution.ConsoleAppFramework.props" />

</Project>
