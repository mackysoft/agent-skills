<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MackySoft.AgentDistribution</AssemblyName>
    <RootNamespace>MackySoft.AgentDistribution</RootNamespace>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MackySoft.AgentDistribution</PackageId>
    <Description>Reusable .NET services for building, distributing, installing, exporting, and diagnosing skills and custom-agent artifacts.</Description>
    <PackageTags>agent;skills;cli;automation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MackySoft.FileSystem" Version="[0.2.1]" />
    <PackageReference Include="MackySoft.FileSystem.Physical" Version="[0.2.1]" />
    <PackageReference Include="MackySoft.Text.Vocabularies" Version="0.1.0" />
  </ItemGroup>

</Project>
