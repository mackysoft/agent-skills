<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MackySoft.AgentSkills</AssemblyName>
    <RootNamespace>MackySoft.AgentSkills</RootNamespace>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MackySoft.AgentSkills</PackageId>
    <Description>Reusable .NET services for building, distributing, installing, exporting, and diagnosing agent skills and custom agents.</Description>
    <PackageTags>agent;skills;cli;automation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MackySoft.FileSystem" Version="0.1.0" />
    <PackageReference Include="MackySoft.Text.Vocabularies" Version="0.1.0" />
  </ItemGroup>

</Project>
